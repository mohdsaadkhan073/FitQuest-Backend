# FitQuest Backend Environment Configuration
# Add your MongoDB connection URI and credentials below

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=fitquest_db

# API Server Configuration
HOST=127.0.0.1
PORT=8000

# Camera & Pose Detection Configuration
MODEL_CAMERA_INDEX=0
MODEL_MIN_DETECTION_CONFIDENCE=0.5

# Arduino / Hardware Servo Lock Configuration
ARDUINO_PORT=COM3
ARDUINO_BAUD_RATE=9600
SERVO_UNLOCK_ANGLE=180
SERVO_LOCKED_ANGLE=0
